FROM rust:1.98-bookworm AS builder

WORKDIR /app

# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends pkg-config libssl-dev \
 && rm -rf /var/lib/apt/lists/*

COPY agent/Cargo.toml agent/Cargo.lock ./
COPY agent/src src

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/cargo-target \
    CARGO_TARGET_DIR=/tmp/cargo-target cargo build --release \
 && mkdir -p /out \
 && cp /tmp/cargo-target/release/k8s-images-manager-agent /out/k8s-images-manager-agent

FROM debian:bookworm-slim

ARG TARGETARCH

RUN groupadd --system --gid 999 k8simagemanager && \
    useradd --system --uid 999 -g k8simagemanager k8simagemanager

# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates sudo wget \
 && rm -rf /var/lib/apt/lists/*

RUN arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
 && case "${arch}" in \
      amd64|arm64) ;; \
      *) echo "unsupported arch: ${arch}" && exit 1 ;; \
    esac \
 && wget --progress=dot:giga -O /tmp/crictl.tgz \
      "https://github.com/kubernetes-sigs/cri-tools/releases/download/v1.35.0/crictl-v1.35.0-linux-${arch}.tar.gz" \
 && tar -C /usr/local/bin -xzf /tmp/crictl.tgz \
 && chmod +x /usr/local/bin/crictl \
 && rm -f /tmp/crictl.tgz

COPY agent/scripts/crictl-images /usr/local/bin/crictl-images
COPY agent/scripts/crictl-rmi /usr/local/bin/crictl-rmi
COPY agent/scripts/crictl-pull /usr/local/bin/crictl-pull
COPY agent/scripts/sudoers /etc/sudoers.d/k8simagemanager-crictl

RUN chmod 755 /usr/local/bin/crictl-images /usr/local/bin/crictl-rmi /usr/local/bin/crictl-pull \
 && chmod 440 /etc/sudoers.d/k8simagemanager-crictl \
 && chown root:root /usr/local/bin/crictl-images /usr/local/bin/crictl-rmi /usr/local/bin/crictl-pull \
      /etc/sudoers.d/k8simagemanager-crictl

COPY --from=builder /out/k8s-images-manager-agent /usr/bin/k8s-images-manager-agent/k8s-images-manager-agent

RUN chown -R k8simagemanager:k8simagemanager /usr/bin/k8s-images-manager-agent

USER 999

ENTRYPOINT ["/usr/bin/k8s-images-manager-agent/k8s-images-manager-agent"]
