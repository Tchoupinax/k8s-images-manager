{
  "version": "0.5.7",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:docker": "turbo run build:docker",
    "check": "gitleaks dir -v && gitleaks git -v",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "knip": "knip",
    "lint": "turbo run lint",
    "lint:dockerfile": "turbo run lint:dockerfile",
    "test": "turbo run test",
    "ui": "pnpm --filter webapp watch:prod",
    "up": "./scripts/dev/tilt-up.sh",
    "upgrade": "pnpm ncu -p pnpm -w -i --cooldown 3 --format group",
    "prewatch": "docker compose up -d",
    "watch": "turbo run watch"
  },
  "devDependencies": {
    "knip": "6.32.3",
    "npm-check-updates": "23.1.0",
    "turbo": "2.10.12"
  },
  "packageManager": "pnpm@11.24.0"
}
