{
  "name": "server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npx prisma generate && tsc",
    "build:docker": "docker build --provenance=false -f Dockerfile -t k8s-images-manager-server:local ..",
    "clean": "rm -rf dist node_modules .turbo",
    "lint": "eslint . --fix",
    "lint:dockerfile": "hadolint Dockerfile",
    "migrate": "DATABASE_URL=postgresql://postgres:mysecret@localhost:5439/postgres npx prisma migrate dev",
    "start": "node --no-warnings --experimental-strip-types src/index.mts",
    "test": "vitest run --config vitest.e2e.config.mts",
    "prewatch": "pnpm migrate",
    "watch": "node --no-warnings --experimental-strip-types --watch src/index.mts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/request-context": "7.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "prisma": "7.10.0",
    "fastify": "5.12.1",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "valienv": "1.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "eslint-config-tchoupinax": "2.6.1",
    "nodemon": "3.1.14",
    "pglite-prisma-adapter": "0.7.2",
    "pino-pretty": "13.1.3",
    "typescript": "6.0.3",
    "vite-node": "6.0.0",
    "vitest": "4.1.11"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
